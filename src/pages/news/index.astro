---
// 소식 목록: 날짜순으로 나열하되, 연속된 사진 소식은 카드 묶음, 연속된 사진 없는 소식은 한 줄 목록 묶음으로 보여줍니다.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import NewsCard from '../../components/NewsCard.astro';
import { news } from '../../lib/news';
import cats from '../../data/news-categories.json';

// 날짜순으로 같은 형태끼리 묶기: [카드 묶음, 목록 묶음, 카드 묶음, ...]
const groups: { photo: boolean; items: typeof news }[] = [];
for (const n of news) {
  const photo = !!n.image;
  const last = groups[groups.length - 1];
  if (last && last.photo === photo) last.items.push(n);
  else groups.push({ photo, items: [n] });
}
---
<Base title="소식">
  <PageHead title="소식" lead="센터 소식, 연구·실증, 기업지원, 교육·세미나 소식을 전합니다." />
  <section>
    <div class="wrap">
      <div class="filter" role="group" aria-label="분류">
        <button type="button" data-cat="" class="on">전체</button>
        {cats.map((c) => <button type="button" data-cat={c}>{c}</button>)}
      </div>

      {groups.map((g) => g.photo ? (
        <div class="grid-3 cards grp">
          {g.items.map((n) => <div data-cat={n.category}><NewsCard item={n} /></div>)}
        </div>
      ) : (
        <ul class="nlist grp">
          {g.items.map((n) => (
            <li data-cat={n.category}>
              <a href={`/news/${n.slug}/`}>
                <time datetime={n.date}>{n.dateLabel}</time>
                <span class="cat">{n.category}</span>
                <span class="tt"><b>{n.title}</b>{n.summary && <small>{n.summary}</small>}</span>
              </a>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>
</Base>

<style>
.filter{display:flex;flex-wrap:wrap;gap:8px}
.filter button{font:600 13.5px var(--sans);color:var(--text2);background:transparent;border:1px solid var(--line);border-radius:999px;padding:6px 14px;cursor:pointer}
.filter button.on,.filter button:hover{color:#fff;border-color:var(--accent);background:var(--accent-soft)}
.grp{margin-top:28px}
.nlist{list-style:none;padding:0;border-top:1px solid var(--line)}
.nlist a{display:grid;grid-template-columns:84px 96px 1fr;gap:4px 16px;align-items:baseline;padding:16px 6px;border-bottom:1px solid var(--line);color:var(--text)}
.nlist a:hover b{color:var(--brand)}
.nlist time{font-family:var(--mono);font-size:13.5px;color:var(--text3)}
.nlist .cat{font-size:12.5px;font-weight:700;color:var(--accent)}
.nlist b{font-weight:600;font-size:16px}
.nlist small{display:block;margin-top:4px;color:var(--text2);font-size:14px}
@media(max-width:700px){.nlist a{grid-template-columns:auto 1fr}.nlist .tt{grid-column:1/-1}}
</style>

<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.filter button')];
  const items = [...document.querySelectorAll<HTMLElement>('.cards > [data-cat], .nlist > [data-cat]')];
  btns.forEach((b) => b.addEventListener('click', () => {
    const c = b.dataset.cat ?? '';
    btns.forEach((x) => x.classList.toggle('on', x === b));
    items.forEach((el) => { el.hidden = !!c && el.dataset.cat !== c; });
    document.querySelectorAll<HTMLElement>('.grp').forEach((g) => { g.hidden = !g.querySelector('[data-cat]:not([hidden])'); });
  }));
</script>
