---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import NewsCard from '../../components/NewsCard.astro';
import { news } from '../../lib/news';
import cats from '../../data/news-categories.json';
---
<Base title="소식">
  <PageHead label="News" title="소식" lead="연구·실증 사례, 기업지원 공고, 교육·세미나 소식을 전합니다." />
  <section>
    <div class="wrap">
      <div class="filter" role="group" aria-label="분류">
        <button type="button" data-cat="" class="on">전체</button>
        {cats.map((c) => <button type="button" data-cat={c}>{c}</button>)}
      </div>
      <div class="grid-3" style="margin-top:24px">
        {news.map((n) => <div data-cat={n.category}><NewsCard item={n} /></div>)}
      </div>
    </div>
  </section>
</Base>

<style>
.filter{display:flex;flex-wrap:wrap;gap:8px}
.filter button{font:600 13.5px var(--sans);color:var(--text2);background:transparent;border:1px solid var(--line);border-radius:999px;padding:6px 14px;cursor:pointer}
.filter button.on,.filter button:hover{color:#fff;border-color:var(--accent);background:var(--accent-soft)}
</style>

<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.filter button')];
  const cards = [...document.querySelectorAll<HTMLElement>('.grid-3 > [data-cat]')];
  btns.forEach((b) => b.addEventListener('click', () => {
    const c = b.dataset.cat ?? '';
    btns.forEach((x) => x.classList.toggle('on', x === b));
    cards.forEach((el) => { el.hidden = !!c && el.dataset.cat !== c; });
  }));
</script>
