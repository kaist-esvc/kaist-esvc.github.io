---
// 연구성과: 진행 중인 사업 → 연구과제·사업 전체 → 논문 → 특허
// 관리 메모
//  - 과제: src/data/projects.json (flagship: true 이면 '진행 중인 사업' 카드 + 상세 페이지,
//    kind: '지원' 이면 연구가 아닌 기업지원·위탁 사업으로 '사업' 태그 표시)
//  - 논문: src/data/publications.json, 특허: src/data/patents.json
//    "projects"에 과제 id를 넣으면 '사사' 표시 + 해당 과제 상세 페이지에 자동으로 나타납니다.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PubList from '../../components/PubList.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import PatentList from '../../components/PatentList.astro';
import { pubs, patents, pubsOf, patentsOf } from '../../lib/outputs';
import projects from '../../data/projects.json';

const flagship = projects.filter((p) => p.flagship);
const all = projects.slice().sort((a, b) => b.period.localeCompare(a.period));
---
<Base title="연구성과">
  <PageHead label="Projects & Publications" title="연구성과"
    links={[{ href: '#flagship', label: '진행 중인 사업' }, { href: '#projects', label: '연구과제·사업' }, { href: '#publications', label: '논문' }, { href: '#patents', label: '특허' }]} />

  <section id="flagship">
    <div class="wrap">
      <div class="label">Ongoing programs</div>
      <h2 class="sec">진행 중인 사업</h2>
      <div class="grid-2" style="margin-top:28px">
        {flagship.map((p) => <ProgramCard p={p} />)}
      </div>
    </div>
  </section>

  <section id="projects" class="alt">
    <div class="wrap">
      <div class="label">Projects &amp; Programs</div>
      <h2 class="sec">연구과제·사업</h2>
      <p class="note">연구과제와 함께, 기업 지원·위탁 사업은 <span class="kind">사업</span> 표시로 구분합니다.</p>
      <div class="table-wrap" style="margin-top:24px">
        <table class="ptable">
          <thead><tr><th>상태</th><th>과제·사업명</th><th>발주기관</th><th>연구기간</th><th>사업비</th><th>책임자</th><th>논문·특허</th></tr></thead>
          <tbody>
            {all.map((p) => (
              <tr id={p.id}>
                <td><span class:list={['st', p.status === '진행' ? 'on' : 'done']}>{p.status}</span></td>
                <td><a href={`/results/${p.id}/`}><b>{p.title}</b></a>{(p as any).kind === '지원' && <span class="kind">사업</span>}{(p as any).note && <small>{(p as any).note}</small>}</td>
                <td>{p.sponsor}</td>
                <td class="nowrap">{p.period}</td>
                <td class="nowrap">{p.budget}</td>
                <td class="nowrap">{p.pi || '—'}</td>
                <td class="nowrap out">{pubsOf(p.id).length + patentsOf(p.id).length > 0 ? <a href={`/results/${p.id}/`}>{[pubsOf(p.id).length && `논문 ${pubsOf(p.id).length}`, patentsOf(p.id).length && `특허 ${patentsOf(p.id).length}`].filter(Boolean).join(' · ')}</a> : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="publications">
    <div class="wrap">
      <div class="label">Publications</div>
      <h2 class="sec">논문 <span class="cnt">{pubs.length || ''}</span></h2>
      <div style="margin-top:20px"><PubList /></div>
    </div>
  </section>

  {patents.length > 0 && (
    <section id="patents" class="alt">
      <div class="wrap">
        <div class="label">Patents</div>
        <h2 class="sec">특허 <span class="cnt">{patents.length}</span></h2>
        <div style="margin-top:20px"><PatentList /></div>
      </div>
    </section>
  )}
</Base>

<style>
.ptable{min-width:900px}
.kind{display:inline-block;margin-left:8px;padding:1px 8px;border-radius:999px;font-size:12px;font-weight:600;color:#f0b44c;border:1px solid rgba(240,180,76,.45);vertical-align:2px}
.note{color:var(--text2);font-size:15px;margin:10px 0 0}
.ptable td b{font-weight:600}
.ptable td a b{color:var(--text)}
.ptable td a:hover b{color:var(--brand)}
.ptable .out a{color:var(--accent);font-size:13.5px}
.cnt{font-size:.55em;color:var(--accent);vertical-align:middle;margin-left:6px}
.ptable small{display:block;color:var(--text3);font-size:12.5px;margin-top:2px}
.nowrap{white-space:nowrap}
</style>
