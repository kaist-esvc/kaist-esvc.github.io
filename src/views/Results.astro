---
// 연구성과 (국문 / 영문 공통): 대표 과제 → 연구과제·사업 전체 → 논문 → 특허
// 페이지 파일: src/pages/results/index.astro, src/pages/en/results/index.astro
// 관리 메모
//  - 과제: src/data/projects.json (flagship: true 이면 '대표 과제' 카드 + 상세 페이지,
//    kind: '지원' 이면 연구가 아닌 기업지원·위탁 사업으로 '사업' 태그 표시)
//  - 논문: src/data/publications.json, 특허: src/data/patents.json
//    "projects"에 과제 id를 넣으면 '사사' 표시 + 해당 과제 상세 페이지에 자동으로 나타납니다.
//  - 영문판은 책임자 이름을 표시하지 않습니다.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PubList from '../components/PubList.astro';
import ProgramCard from '../components/ProgramCard.astro';
import PatentList from '../components/PatentList.astro';
import { pubs, patents, pubsOf, patentsOf } from '../lib/outputs';
import { tr, budget, statusLabel, href as L, type Lang } from '../lib/i18n';
import projects from '../data/projects.json';

interface Props { lang?: Lang }
const { lang = 'ko' } = Astro.props;
const en = lang === 'en';
const t = (ko: string, eng: string) => (en ? eng : ko);

const flagship = projects.filter((p) => p.flagship);
const all = projects.slice().sort((a, b) => b.period.localeCompare(a.period));
const outs = (id: string) => {
  const np = pubsOf(id).length, nt = patentsOf(id).length;
  return [np && `${t('논문', 'Papers')} ${np}`, nt && `${t('특허', 'Patents')} ${nt}`].filter(Boolean).join(' · ');
};
const tag = t('사업', 'Program');
---
<Base title={t('연구성과', 'Research')} lang={lang}>
  <PageHead title={t('연구성과', 'Research & Outputs')}
    links={[
      { href: '#flagship', label: t('대표 과제', 'Flagship projects') },
      { href: '#projects', label: t('연구과제·사업', 'Projects & programs') },
      { href: '#publications', label: t('논문', 'Publications') },
      { href: '#patents', label: t('특허', 'Patents') },
    ]} />

  <section id="flagship">
    <div class="wrap">
      <h2 class="sec">{t('대표 과제', 'Flagship projects')}</h2>
      <div class="grid-2" style="margin-top:28px">
        {flagship.map((p) => <ProgramCard p={p} lang={lang} />)}
      </div>
    </div>
  </section>

  <section id="projects" class="alt">
    <div class="wrap">
      <h2 class="sec">{t('연구과제·사업', 'Projects & programs')}</h2>
      <p class="note"><span class="kind">{tag}</span> {t('기업 지원·위탁 사업', 'Company support and commissioned programs')}</p>
      <div class="table-wrap" style="margin-top:24px">
        <table class="ptable">
          <thead><tr>
            <th>{t('상태', 'Status')}</th><th>{t('과제·사업명', 'Title')}</th><th>{t('발주기관', 'Sponsor')}</th><th>{t('연구기간', 'Period')}</th><th>{t('사업비', 'Budget')}</th>{!en && <th>책임자</th>}<th>{t('논문·특허', 'Outputs')}</th>
          </tr></thead>
          <tbody>
            {all.map((p) => (
              <tr id={p.id}>
                <td><span class:list={['st', p.status === '진행' ? 'on' : 'done']}>{statusLabel(p.status, lang)}</span></td>
                <td><a href={L(lang, `/results/${p.id}/`)}><b>{tr(p, 'title', lang)}</b></a>{(p as any).kind === '지원' && <span class="kind">{tag}</span>}{(p as any).note && <small>{tr(p, 'note', lang)}</small>}</td>
                <td>{tr(p, 'sponsor', lang)}</td>
                <td class="nowrap">{p.period}</td>
                <td class="nowrap">{budget(p.budget, lang)}</td>
                {!en && <td class="nowrap">{p.pi || '—'}</td>}
                <td class="nowrap out">{outs(p.id) ? <a href={L(lang, `/results/${p.id}/`)}>{outs(p.id)}</a> : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="publications">
    <div class="wrap">
      <h2 class="sec">{t('논문', 'Publications')} <span class="cnt">{pubs.length || ''}</span></h2>
      <div style="margin-top:20px"><PubList lang={lang} /></div>
    </div>
  </section>

  {patents.length > 0 && (
    <section id="patents" class="alt">
      <div class="wrap">
        <h2 class="sec">{t('특허', 'Patents')} <span class="cnt">{patents.length}</span></h2>
        <div style="margin-top:20px"><PatentList lang={lang} /></div>
      </div>
    </section>
  )}
</Base>

<style>
.ptable{min-width:900px}
.kind{display:inline-block;margin-left:8px;padding:1px 8px;border-radius:999px;font-size:12px;font-weight:600;color:#f0b44c;border:1px solid rgba(240,180,76,.45);vertical-align:2px}
.note{color:var(--text2);font-size:14px;margin:10px 0 0}
.note .kind{margin:0 6px 0 0}
.ptable td b{font-weight:600}
.ptable td a b{color:var(--text)}
.ptable td a:hover b{color:var(--brand)}
.ptable .out a{color:var(--accent);font-size:13.5px}
.cnt{font-size:.55em;color:var(--accent);vertical-align:middle;margin-left:6px}
.ptable small{display:block;color:var(--text3);font-size:12.5px;margin-top:2px}
.nowrap{white-space:nowrap}
</style>
