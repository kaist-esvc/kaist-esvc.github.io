---
// 센터 소개 (국문 / 영문 공통). 페이지 파일: src/pages/about.astro, src/pages/en/about.astro
// 영문판은 구성원 표(이름·이메일)를 싣지 않고 센터장·팀 구성만 보여줍니다.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import history from '../data/history.json';
import people from '../data/people.json';
import site from '../data/site.json';
import { tr, type Lang } from '../lib/i18n';

interface Props { lang?: Lang }
const { lang = 'ko' } = Astro.props;
const en = lang === 'en';
const t = (ko: string, eng: string) => (en ? eng : ko);
const d = people.director as any;

const axes = en ? [
  {
    en: 'Research', title: 'Core technologies for electrified, intelligent mobility', sub: 'Design · Control · Operation',
    items: ['Efficiency-driven design of electric drives, batteries and energy systems', 'Optimal and learning-based control to maximize vehicle performance and efficiency', 'Large joint research such as Glocal Lab, and training the next generation of researchers'],
  },
  {
    en: 'Validation', title: 'Vehicle and field validation based in Jeju', sub: 'EV-LAB · Jeju field',
    items: ['Testing and evaluation at EV-LAB, from components to complete vehicles', "Vehicle validation on Jeju's roads and energy systems", 'Feeding field findings back into research'],
  },
  {
    en: 'Industry', title: 'Growing tech startups and the industry ecosystem', sub: 'Industry collaboration',
    items: ['Technology advancement support for Route330 tech startups', 'Planning joint R&D and government projects, and opening test equipment', "Growing Jeju's mobility industry through company attraction and incubation"],
  },
] : [
  {
    en: 'Research', title: '전동화·지능형 모빌리티 원천기술 개발', sub: '설계 · 제어 · 운영',
    items: ['전기구동계·배터리·에너지 시스템의 효율 중심 설계', '최적제어와 학습 기반 제어로 차량 성능·효율 극대화', '글로컬랩 등 대형 공동연구와 학문후속세대 양성'],
  },
  {
    en: 'Validation', title: '제주 기반 실차·현장 실증 체계 구축', sub: 'EV-LAB · 제주 현장',
    items: ['EV-LAB에서 부품부터 완성차까지 시험·평가', '제주의 도로·에너지 환경에서 실차 주행 검증', '현장에서 발견한 문제를 다시 연구로 환류'],
  },
  {
    en: 'Industry', title: '기술창업기업 성장과 산업 생태계 조성', sub: '산학협력 · 기업지원',
    items: ['Route330 입주 기술창업기업의 기술고도화 지원', '공동 R&D·정부과제 기획과 시험장비 개방', '기업 유치·인큐베이팅으로 제주 모빌리티 산업 육성'],
  },
];
const mapUrl = en
  ? `https://www.google.com/maps/search/${encodeURIComponent('330 Cheomdan-ro, Jeju-si, Jeju-do')}`
  : `https://map.naver.com/p/search/${encodeURIComponent('제주시 첨단로 330')}`;
---
<Base title={t('센터 소개', 'About')} lang={lang}>
  <PageHead title={t('센터 소개', 'About the Center')}
    links={[
      { href: '#greeting', label: t('인사말', 'Greeting') },
      { href: '#vision', label: t('비전 및 목표', 'Vision & goals') },
      { href: '#history', label: t('연혁', 'History') },
      { href: '#people', label: t('구성원', 'People') },
      { href: '#location', label: t('오시는 길', 'Location') },
    ]} />

  <!-- 인사말 -->
  <section id="greeting">
    <div class="wrap greet">
      <div class="side">
        <h2 class="sec">{t('인사말', 'Greeting')}</h2>
        <img class="photo" src={d.photo} alt={en ? `Director ${d.nameEn}` : `센터장 ${d.name}`} />
      </div>
      {en ? (
        <div class="prose">
          <p class="headline">Validating the future of<br />carbon-neutral mobility in Jeju</p>
          <p>On the road to carbon neutrality, electrifying mobility is no longer an option but a given. Yet replacing an engine with a battery and a motor does not, by itself, make mobility sustainable. What lets a vehicle travel farther and more safely on the same energy is intelligence: the ability to read its surroundings and make its own decisions. Intelligence pushes the performance and efficiency of electrified vehicles to their limits, and turns each vehicle into part of an energy system that works together with charging infrastructure, renewable energy and the power grid.</p>
          <p>The KAIST Eco-friendly Smart Vehicle Research Center develops core technologies for the design, control and operation of electrified, intelligent mobility. Jeju, with diverse roads linking the coast and the mid-mountain areas and abundant wind and solar power on a single island, is an ideal place to validate mobility and energy technologies together. We test components and vehicles at the Jeju EV-LAB, confirm the results on Jeju's real roads and energy systems, and bring the problems we find in the field back to the lab as new research questions.</p>
          <p>Going forward, we aim to be an open validation platform where universities, research institutes and companies design tests together and share the results. We will grow Jeju into a global validation hub for electrified, intelligent mobility, so that technologies proven here reach mobility industries in Korea and around the world.</p>
          <p class="sign"><b>{d.nameEn}</b><br />Director, KAIST Eco-friendly Smart Vehicle Research Center</p>
        </div>
      ) : (
        <div class="prose">
          <p class="headline">탄소중립 시대, 모빌리티의 해답을<br />제주에서 검증합니다</p>
          <p>탄소중립으로 향하는 길에서 모빌리티의 전동화는 이제 선택이 아닌 전제가 되었습니다. 그러나 엔진을 배터리와 모터로 바꾸는 것만으로 친환경 모빌리티가 완성되지는 않습니다. 같은 에너지로 더 멀리, 더 안전하게 달리게 하는 힘은 차량이 상황을 읽고 스스로 판단하는 지능화에서 나옵니다. 지능화는 전동화 차량의 성능과 효율을 끝까지 끌어올리고, 차량을 충전 인프라와 재생에너지, 전력망과 함께 움직이는 에너지 시스템의 일부로 만듭니다.</p>
          <p>KAIST 친환경스마트자동차연구센터는 이러한 전동화·지능형 모빌리티의 설계·제어·운영 원천기술을 연구합니다. 제주는 해안과 중산간을 잇는 다양한 도로와 풍력·태양광 같은 재생에너지가 한 섬 안에 모여 있어, 모빌리티와 에너지 기술을 함께 검증하기에 더없이 좋은 무대입니다. 센터는 제주 EV-LAB의 시험장비로 부품과 차량을 검증하고, 제주의 실제 도로와 에너지 환경에서 그 결과를 확인하며, 현장에서 발견한 문제를 다시 연구의 출발점으로 삼습니다.</p>
          <p>앞으로 센터는 대학과 연구기관, 기업이 함께 시험을 설계하고 결과를 나누는 열린 실증 플랫폼으로 자리매김하고자 합니다. 제주에서 검증한 기술이 국내외 모빌리티 산업의 현장으로 이어지도록, 제주를 전동화·지능형 모빌리티의 글로벌 실증 거점으로 키워 나가겠습니다.</p>
          <p>감사합니다.</p>
          <p class="sign">KAIST 친환경스마트자동차연구센터장 <b>{d.name}</b></p>
        </div>
      )}
    </div>
  </section>

  <!-- 비전 및 목표 -->
  <section id="vision" class="alt">
    <div class="wrap">
      <h2 class="sec">{t('비전 및 목표', 'Vision & goals')}</h2>
      <div class="vision">
        <span class="label">Vision</span>
        {en
          ? <p><em>Jeju's innovation hub for electrified, intelligent mobility</em>, linking research, validation and industry</p>
          : <p>연구·실증·산업화를 잇는 <em>제주 전동화·지능형 모빌리티 혁신 거점</em></p>}
      </div>
      <div class="grid-3" style="margin-top:20px">
        {axes.map((a, i) => (
          <div class="card goal">
            <div class="ghead"><span class="label">{String(i + 1).padStart(2, '0')}</span><span class="kw">{a.sub}</span></div>
            <h3>{a.title}</h3>
            <ul>{a.items.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 연혁 -->
  <section id="history">
    <div class="wrap">
      <h2 class="sec">{t('연혁', 'History')}</h2>
      <ol class="timeline" style="margin-top:32px">
        {history.slice().reverse().map((h) => <li><b>{h.date}</b><p>{tr(h, 'text', lang)}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- 구성원 -->
  <section id="people" class="alt">
    <div class="wrap">
      <h2 class="sec">{t('구성원', 'People')}</h2>

      <div class="org">
        <div class="card dir">
          <img src={d.photo} alt="" />
          <div>
            <div class="label">{tr(d, 'title', lang)}</div>
            <h3>{tr(d, 'name', lang)}</h3>
            <p>{tr(d, 'affiliation', lang)}</p>
            <a class="more" href={d.labUrl} target="_blank" rel="noopener">{tr(d, 'lab', lang)}</a>
          </div>
        </div>
        <div class="teams">
          {people.teams.map((tm) => <div class="card team"><b>{tr(tm, 'name', lang)}</b><span>{tr(tm, 'desc', lang)}</span></div>)}
        </div>
      </div>

      {!en && [['연구팀 구성원', people.research], ['행정팀 구성원', people.admin]].map(([label, list]) => (
        <>
          <h3 class="grp">{label}</h3>
          <div class="table-wrap">
            <table class="members">
              <colgroup><col style="width:16%" /><col style="width:16%" /><col style="width:40%" /><col style="width:28%" /></colgroup>
              <thead><tr><th>성명</th><th>직명</th><th>담당 업무</th><th>이메일</th></tr></thead>
              <tbody>
                {(list as typeof people.research).map((m) => (
                  <tr><td><b>{m.name}</b></td><td>{m.position}</td><td>{m.duty || '—'}</td><td><a href={`mailto:${m.email}`}>{m.email}</a></td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ))}
    </div>
  </section>

  <!-- 오시는 길 -->
  <section id="location">
    <div class="wrap">
      <h2 class="sec">{t('오시는 길', 'Location')}</h2>
      <div class="card loc">
        <div>
          <h3>{t('KAIST 친환경스마트자동차연구센터 · 제주 EV-LAB', 'KAIST ESVC · Jeju EV-LAB')}</h3>
          <p>{tr(site, 'address', lang)}<br />{tr(site, 'addressDetail', lang)}</p>
        </div>
        <div>
          <p><b>{t('이메일', 'Email')}</b> {site.email}</p>
          <p><b>{t('전화', 'Phone')}</b> {tr(site, 'phone', lang)}</p>
          <a class="more" href={mapUrl} target="_blank" rel="noopener">{t('지도에서 보기', 'View on map')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
.greet{display:grid;grid-template-columns:.65fr 1.35fr;gap:56px;align-items:start}
.photo{width:100%;max-width:200px;aspect-ratio:4/5;object-fit:cover;object-position:top;border-radius:16px;margin-top:24px}
.headline{color:var(--text);font-size:clamp(21px,2.2vw,26px);font-weight:700;line-height:1.45;margin-bottom:24px!important}
.sign{margin-top:28px;text-align:right;color:var(--text2)}
.sign b{color:var(--text);font-size:19px;margin-left:8px}
.vision{margin-top:24px;padding:18px 28px;border-radius:14px;background:linear-gradient(110deg,#1565c0,#0e8f86);display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.vision .label{color:#b5fff0}
.vision p{margin:0;font-size:clamp(17px,1.8vw,21px);font-weight:700}
.vision em{font-style:normal;color:#d9fff6}
.ghead{display:flex;justify-content:space-between;align-items:center;gap:10px;padding-bottom:14px;border-bottom:1px solid var(--line)}
.ghead .kw{font-size:13px;color:var(--text2);background:rgba(255,255,255,.05);border-radius:999px;padding:3px 12px;white-space:nowrap}
.goal h3{margin:16px 0 14px;font-size:19px;line-height:1.4}
.goal ul{margin:0;padding-left:18px;color:var(--text2);font-size:15px}
.goal li{margin-bottom:6px}
.org{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:28px}
.dir{display:flex;gap:22px;align-items:center}
.dir img{width:88px;height:88px;border-radius:50%;object-fit:cover;object-position:top;flex:none}
.dir h3{margin:4px 0;font-size:22px}
.dir p{margin:0 0 6px;color:var(--text2);font-size:15px}
.teams{display:grid;gap:12px}
.team{display:flex;flex-direction:column;gap:4px;padding:18px 22px}
.team span{color:var(--text2);font-size:14.5px}
.grp{font-size:17px;margin:36px 0 12px}
td a{color:var(--brand)}
.members{table-layout:fixed;width:100%;min-width:640px}
.loc{display:grid;grid-template-columns:1.3fr 1fr;gap:32px;margin-top:28px}
.loc h3{margin:0 0 8px;font-size:19px}
.loc p{color:var(--text2);margin:0 0 8px}
.loc b{color:var(--text);margin-right:8px}
@media(max-width:900px){.greet,.org,.loc{grid-template-columns:1fr}.photo{max-width:160px}}
</style>
