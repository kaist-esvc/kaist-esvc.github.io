---
interface Props { label?: string; title: string; lead?: string; links?: { href: string; label: string }[] }
const { label, title, lead, links = [] } = Astro.props;
---
<div class="page-head">
  <div class="wrap">
    {label && <div class="label">{label}</div>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {links.length > 0 && (
      <nav class="subnav" aria-label="페이지 내 이동">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    )}
  </div>
</div>
