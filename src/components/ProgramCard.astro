---
// 대표 과제 카드: 모든 사업이 같은 항목(발주기관·기간·사업비·책임자)을 같은 순서로 보여줍니다.
// 영문판은 책임자 이름을 표시하지 않습니다.
import { tr, budget, href as L, type Lang } from '../lib/i18n';
interface Props { p: any; href?: string; lang?: Lang }
const { p, lang = 'ko' } = Astro.props;
const en = lang === 'en';
const link = Astro.props.href ?? L(lang, `/results/${p.id}/`);
const rows = (en
  ? [['Sponsor', tr(p, 'sponsor', lang)], ['Period', p.period], ['Budget', budget(p.budget, lang)]]
  : [['발주기관', p.sponsor], ['기간', p.period], ['사업비', p.budget], ['책임자', p.pi]]
).filter(([, v]) => v) as [string, string][];
---
<a class="program" href={link}>
  <div class="in">
    <h3>{tr(p, 'short', lang) ?? tr(p, 'title', lang)}</h3>
    {p.summary && <p>{tr(p, 'summary', lang)}</p>}
    <dl class="facts">
      {rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
    <span class="go">{en ? 'Learn more →' : '자세히 보기 →'}</span>
  </div>
</a>

<style>
.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 18px;margin:18px 0 0;padding-top:16px;border-top:1px solid rgba(255,255,255,.22)}
.facts div{display:flex;gap:10px;font-size:13.5px}
.facts dt{opacity:.7;min-width:56px;flex:none}
.facts dd{margin:0}
.go{display:inline-block;margin-top:16px;font-weight:700;font-size:14px}
@media(max-width:560px){.facts{grid-template-columns:1fr}}
</style>
