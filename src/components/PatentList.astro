---
// 특허 목록. 데이터: src/data/patents.json (형식은 README 참고)
// 영문판: titleEn 이 있으면 영문 제목, 발명자는 표시하지 않음.
import { patents as all, projectName } from '../lib/outputs';
import { tr, href, type Lang } from '../lib/i18n';
interface Props { project?: string; showAck?: boolean; lang?: Lang }
const { project, showAck = true, lang = 'ko' } = Astro.props;
const en = lang === 'en';
const list = project ? all.filter((p) => p.projects?.includes(project)) : all;
const st = (s: string) => (en ? ({ 등록: 'Granted', 출원: 'Pending' } as Record<string, string>)[s] ?? s : s);
const num = (p: (typeof all)[number]) =>
  p.status === '등록'
    ? `${en ? 'Reg. No.' : '등록'} ${p.regNo}${p.regDate ? ` (${p.regDate})` : ''}`
    : `${en ? 'App. No.' : '출원'} ${p.appNo}${p.appDate ? ` (${p.appDate})` : ''}`;
---
{list.length > 0 && (
  <ul class="pubs">
    {list.map((p) => (
      <li>
        <div class="ptitle">
          <span class="ptype patent">{p.country} {st(p.status)}</span>
          {p.link ? <a href={p.link} target="_blank" rel="noopener">{tr(p, 'title', lang)}</a> : tr(p, 'title', lang)}
        </div>
        {!en && <div class="pmeta">{p.inventors}</div>}
        <div class="pmeta"><i>{num(p)}</i></div>
        {showAck && p.projects && p.projects.length > 0 && (
          <div class="ack">{en ? 'Funded by' : '사사'} · {p.projects.map((id, i) => <>{i > 0 && ', '}<a href={href(lang, `/results/${id}/`)}>{projectName(id, lang)}</a></>)}</div>
        )}
      </li>
    ))}
  </ul>
)}
